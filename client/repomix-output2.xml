  ? mockAuthApi
  : {
      login: async (credentials) => {
        const response = await apiClient.post(`${ENDPOINT}/login`, credentials);
        return response.data;
      },

      logout: async () => {
        const response = await apiClient.post(`${ENDPOINT}/logout`);
        return response.data;
